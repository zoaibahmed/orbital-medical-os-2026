# Copy to .env for local overrides. These are public addresses/settings, not secrets.
API_HOST=127.0.0.1
API_PORT=5001
DEMO_DATA_FILE=.local-data/medbay.json
CORS_ORIGINS=http://127.0.0.1:5186,http://localhost:5186,http://127.0.0.1:5187,http://localhost:5187,http://127.0.0.1:5001,http://localhost:5001
# Vite proxy destination; used in development and preview, never bundled.
API_PROXY_TARGET=http://127.0.0.1:5001
# Client URL must end in /api. Empty means same-origin /api (recommended).
VITE_API_BASE_URL=
